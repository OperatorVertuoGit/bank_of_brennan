# Copy to ops/.env (gitignored) and fill in. Nothing here belongs in the repo.

# Tier 1 — working scan drive. Every job folder is $SCAN_ROOT/<job_id>/
SCAN_ROOT=/Volumes/scan-archive

# Tier 2 — cold archive + client delivery (S3, B2, Google Drive mount, etc.)
ARCHIVE_URI=s3://pierpoint3d-archive

# Website form provider — its webhook posts submissions to scripts/intake_from_form.py
FORM_PROVIDER_EXPORT=
FORM_WEBHOOK_SECRET=

# Payments — reference IDs only are ever stored in this repo
STRIPE_SECRET_KEY=

# Deploy target for website/public/
DEPLOY_HOOK_URL=
