# Airtable personal access token.
#   create-base needs:  schema.bases:write, schema.bases:read
#   import/export need: data.records:read, data.records:write, schema.bases:read
AIRTABLE_PAT=<your-airtable-personal-access-token>

# Set after the base exists.
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Only needed when creating a new base.
AIRTABLE_WORKSPACE_ID=wspXXXXXXXXXXXXXX

# Source CRS of the surveyor's coordinates. CONFIRM THIS WITH THE SURVEYOR.
# Clark County NV is the Nevada East zone. Likely candidates:
#   3421 = NAD83 / Nevada East (ftUS)
#   6428 = NAD83(2011) / Nevada East (ftUS)
# If the job is on a scaled ground system, no EPSG code describes it -- you need
# the surveyor's calibration parameters instead.
SURVEY_EPSG=3421

# Webapp
MAPBOX_TOKEN=pk.XXXX
MAPBOX_TILESET_ID=you.henderson-survey
