{
  "$comment": "Henderson NV tilt-up survey database. Single source of truth for scripts/create_airtable_base.py. Fields with apiCreatable=false cannot be made by the Airtable Meta API (formula/rollup/lookup/count) - the script prints them as a manual checklist.",
  "version": "1.0.0",
  "project": "Henderson NV Tilt-Up Survey",
  "units": {
    "linear": "US survey foot",
    "vertical_datum": "NAVD88",
    "note": "Confirm horizontal CRS and unit (US survey ft vs international ft) with the surveyor of record before importing."
  },
  "statusColors": {
    "Design": "#94A3B8",
    "Staked": "#3B82F6",
    "As-Built": "#8B5CF6",
    "Verified": "#10B981",
    "Out of Tolerance": "#EF4444",
    "Superseded": "#D1D5DB",
    "Void": "#F3F4F6"
  },
  "panelStatusColors": {
    "Not Cast": "#E5E7EB",
    "Cast": "#FCD34D",
    "Cured": "#FBBF24",
    "Stripped": "#FBBF24",
    "Staged": "#F59E0B",
    "Erected": "#60A5FA",
    "Braced": "#3B82F6",
    "Welded": "#8B5CF6",
    "Grouted": "#34D399",
    "Braces Removed": "#34D399",
    "Patched": "#10B981",
    "Accepted": "#10B981"
  },
  "tables": [
    {
      "name": "Coordinate Systems",
      "description": "CRS reference and site calibration parameters.",
      "primaryField": "CRS Name",
      "fields": [
        {"name": "CRS Name", "type": "singleLineText"},
        {"name": "EPSG Code", "type": "number", "options": {"precision": 0}},
        {"name": "Type", "type": "singleSelect", "options": {"choices": ["Projected", "Geographic", "Local/Ground"]}},
        {"name": "Linear Unit", "type": "singleSelect", "options": {"choices": ["US survey foot", "International foot", "Meter"]}},
        {"name": "Vertical Datum", "type": "singleLineText"},
        {"name": "Geoid Model", "type": "singleLineText"},
        {"name": "PROJ String", "type": "multilineText"},
        {"name": "WKT", "type": "multilineText"},
        {"name": "Is Ground System", "type": "checkbox"},
        {"name": "Combined Factor", "type": "number", "options": {"precision": 8}},
        {"name": "Origin Shift N", "type": "number", "options": {"precision": 3}},
        {"name": "Origin Shift E", "type": "number", "options": {"precision": 3}},
        {"name": "Verified By", "type": "singleLineText"},
        {"name": "Verified Date", "type": "date"},
        {"name": "Notes", "type": "multilineText"}
      ]
    },
    {
      "name": "Layers",
      "description": "Map layer registry. Drives Mapbox styling and the webapp layer switcher.",
      "primaryField": "Layer ID",
      "fields": [
        {"name": "Layer ID", "type": "singleLineText", "note": "lowercase slug; must equal the tippecanoe -l source-layer name"},
        {"name": "Display Name", "type": "singleLineText"},
        {"name": "Geometry Type", "type": "singleSelect", "options": {"choices": ["Point", "LineString", "Polygon"]}},
        {"name": "Category", "type": "singleSelect", "options": {"choices": ["Control", "Layout", "As-Built", "Design", "Structural", "Utilities", "Sitework", "Topo", "Reference"]}},
        {"name": "Discipline", "type": "singleSelect", "options": {"choices": ["Survey", "Concrete", "Structural", "Civil", "MEP", "Architectural"]}},
        {"name": "Tileset ID", "type": "singleLineText"},
        {"name": "Source Layer", "type": "singleLineText"},
        {"name": "Min Zoom", "type": "number", "options": {"precision": 0}},
        {"name": "Max Zoom", "type": "number", "options": {"precision": 0}},
        {"name": "Draw Order", "type": "number", "options": {"precision": 0}},
        {"name": "Color", "type": "singleLineText"},
        {"name": "Color By Status", "type": "checkbox"},
        {"name": "Line Width", "type": "number", "options": {"precision": 1}},
        {"name": "Line Dash", "type": "singleLineText"},
        {"name": "Circle Radius", "type": "number", "options": {"precision": 1}},
        {"name": "Icon Name", "type": "singleLineText"},
        {"name": "Opacity", "type": "number", "options": {"precision": 2}},
        {"name": "Visible By Default", "type": "checkbox"},
        {"name": "In Layer Switcher", "type": "checkbox"},
        {"name": "Clusterable", "type": "checkbox"},
        {"name": "Label Field", "type": "singleLineText"},
        {"name": "Popup Fields", "type": "multilineText", "note": "JSON array of field names"},
        {"name": "Filter Expression", "type": "multilineText"},
        {"name": "Legend Group", "type": "singleLineText"},
        {"name": "Notes", "type": "multilineText"},
        {"name": "Feature Count", "type": "rollup", "apiCreatable": false, "manual": "Rollup COUNT over Point Features + Line Features links"}
      ]
    },
    {
      "name": "Feature Codes",
      "description": "Field code dictionary. Join key between the data collector and the map; holds tolerances.",
      "primaryField": "Code",
      "fields": [
        {"name": "Code", "type": "singleLineText"},
        {"name": "Description", "type": "singleLineText"},
        {"name": "Geometry Type", "type": "singleSelect", "options": {"choices": ["Point", "LineString"]}},
        {"name": "Layer", "type": "multipleRecordLinks", "linkedTable": "Layers"},
        {"name": "Discipline", "type": "singleSelect", "options": {"choices": ["Survey", "Concrete", "Structural", "Civil", "MEP", "Architectural"]}},
        {"name": "Tolerance H (ft)", "type": "number", "options": {"precision": 4}},
        {"name": "Tolerance V (ft)", "type": "number", "options": {"precision": 4}},
        {"name": "Tolerance Source", "type": "singleLineText"},
        {"name": "Required Attributes", "type": "multilineText"},
        {"name": "Requires Panel Link", "type": "checkbox"},
        {"name": "Active", "type": "checkbox"}
      ]
    },
    {
      "name": "Projects",
      "description": "Top-level container. CRS, map extent, tileset binding.",
      "primaryField": "Project Name",
      "fields": [
        {"name": "Project Name", "type": "singleLineText"},
        {"name": "Project Number", "type": "singleLineText"},
        {"name": "Client / Owner", "type": "singleLineText"},
        {"name": "General Contractor", "type": "singleLineText"},
        {"name": "Address", "type": "singleLineText"},
        {"name": "City", "type": "singleLineText"},
        {"name": "County", "type": "singleLineText"},
        {"name": "State", "type": "singleLineText"},
        {"name": "APN", "type": "singleLineText"},
        {"name": "Status", "type": "singleSelect", "options": {"choices": ["Preconstruction", "Active", "Punch", "Closeout", "Archived"]}},
        {"name": "Horizontal CRS", "type": "multipleRecordLinks", "linkedTable": "Coordinate Systems"},
        {"name": "Vertical Datum", "type": "singleLineText"},
        {"name": "Basis of Bearing", "type": "multilineText"},
        {"name": "Site Calibration File", "type": "multipleAttachments"},
        {"name": "Combined Scale Factor", "type": "number", "options": {"precision": 8}},
        {"name": "Start Date", "type": "date"},
        {"name": "Target Completion", "type": "date"},
        {"name": "Map Center Lon", "type": "number", "options": {"precision": 8}},
        {"name": "Map Center Lat", "type": "number", "options": {"precision": 8}},
        {"name": "Map Default Zoom", "type": "number", "options": {"precision": 1}},
        {"name": "BBox W", "type": "number", "options": {"precision": 8}},
        {"name": "BBox S", "type": "number", "options": {"precision": 8}},
        {"name": "BBox E", "type": "number", "options": {"precision": 8}},
        {"name": "BBox N", "type": "number", "options": {"precision": 8}},
        {"name": "Mapbox Tileset ID", "type": "singleLineText"},
        {"name": "Notes", "type": "multilineText"}
      ]
    },
    {
      "name": "Areas",
      "description": "Buildings, phases, yards. Carries the rotated building grid.",
      "primaryField": "Area Code",
      "fields": [
        {"name": "Area Code", "type": "singleLineText"},
        {"name": "Area Name", "type": "singleLineText"},
        {"name": "Project", "type": "multipleRecordLinks", "linkedTable": "Projects"},
        {"name": "Type", "type": "singleSelect", "options": {"choices": ["Building", "Parking", "Yard", "Offsite", "Utility Corridor", "Phase", "Detention"]}},
        {"name": "Building Footprint SF", "type": "number", "options": {"precision": 0}},
        {"name": "Finish Floor Elevation", "type": "number", "options": {"precision": 3}},
        {"name": "Grid Origin Northing", "type": "number", "options": {"precision": 3}},
        {"name": "Grid Origin Easting", "type": "number", "options": {"precision": 3}},
        {"name": "Grid Rotation (deg)", "type": "number", "options": {"precision": 6}, "note": "Building grid azimuth relative to grid north. Required."},
        {"name": "Status", "type": "singleSelect", "options": {"choices": ["Not Started", "Sitework", "Foundations", "Slab", "Casting", "Erecting", "Complete"]}},
        {"name": "Notes", "type": "multilineText"},
        {"name": "Panel Count", "type": "count", "apiCreatable": false, "manual": "Count of linked Panels"},
        {"name": "Panels Erected", "type": "rollup", "apiCreatable": false, "manual": "Rollup over Panels, COUNTA of records with Set Status in Erected+"},
        {"name": "Erection %", "type": "formula", "apiCreatable": false, "manual": "IF({Panel Count}=0, 0, {Panels Erected}/{Panel Count})"}
      ]
    },
    {
      "name": "Control Points",
      "description": "Control and benchmarks. Deliberately separate from Point Features.",
      "primaryField": "Point ID",
      "fields": [
        {"name": "Point ID", "type": "singleLineText"},
        {"name": "Type", "type": "singleSelect", "options": {"choices": ["Primary Control", "Secondary Control", "Benchmark", "Site Monument", "Property Corner", "Reference Point", "Temporary"]}},
        {"name": "Project", "type": "multipleRecordLinks", "linkedTable": "Projects"},
        {"name": "Northing", "type": "number", "options": {"precision": 3}},
        {"name": "Easting", "type": "number", "options": {"precision": 3}},
        {"name": "Elevation", "type": "number", "options": {"precision": 3}},
        {"name": "Longitude", "type": "number", "options": {"precision": 8}},
        {"name": "Latitude", "type": "number", "options": {"precision": 8}},
        {"name": "Order / Class", "type": "singleSelect", "options": {"choices": ["1st", "2nd", "3rd", "Local"]}},
        {"name": "Monument Type", "type": "singleSelect", "options": {"choices": ["Rebar w/ Cap", "Mag Nail", "Hub & Tack", "Brass Disc", "Control Point (X)", "PK Nail", "Iron Pipe", "Other"]}},
        {"name": "Established By", "type": "singleLineText"},
        {"name": "Established Date", "type": "date"},
        {"name": "Status", "type": "singleSelect", "options": {"choices": ["Active", "Recovered", "Disturbed", "Destroyed", "Superseded"]}},
        {"name": "Last Verified", "type": "date"},
        {"name": "Verify Δ H (ft)", "type": "number", "options": {"precision": 3}},
        {"name": "Verify Δ V (ft)", "type": "number", "options": {"precision": 3}},
        {"name": "Description", "type": "multilineText"},
        {"name": "Photo", "type": "multipleAttachments"},
        {"name": "Layer", "type": "multipleRecordLinks", "linkedTable": "Layers"}
      ]
    },
    {
      "name": "Survey Sessions",
      "description": "Field visit provenance and QC. Every feature links to exactly one session.",
      "primaryField": "Session ID",
      "fields": [
        {"name": "Session ID", "type": "singleLineText"},
        {"name": "Date", "type": "date"},
        {"name": "Project", "type": "multipleRecordLinks", "linkedTable": "Projects"},
        {"name": "Areas", "type": "multipleRecordLinks", "linkedTable": "Areas"},
        {"name": "Crew Chief", "type": "singleLineText"},
        {"name": "Crew", "type": "singleLineText"},
        {"name": "Instrument", "type": "singleSelect", "options": {"choices": ["Trimble R12i", "Trimble SX12", "Leica TS16", "Total Station (other)", "GNSS Rover (other)", "UAV Photogrammetry", "Terrestrial Scan"]}},
        {"name": "Method", "type": "singleSelect", "options": {"choices": ["Network RTK/VRS", "Base+Rover RTK", "Static", "TS Traverse", "TS Radial", "Level Loop", "Scan", "Photogrammetry"]}},
        {"name": "Base / Control Used", "type": "multipleRecordLinks", "linkedTable": "Control Points"},
        {"name": "Localization Applied", "type": "checkbox"},
        {"name": "Check Δ Horizontal (ft)", "type": "number", "options": {"precision": 3}},
        {"name": "Check Δ Vertical (ft)", "type": "number", "options": {"precision": 3}},
        {"name": "Closure Error", "type": "number", "options": {"precision": 4}},
        {"name": "Raw Data File", "type": "multipleAttachments"},
        {"name": "Weather / PDOP Notes", "type": "multilineText"},
        {"name": "Approved By", "type": "singleLineText"},
        {"name": "Approved Date", "type": "date"},
        {"name": "Notes", "type": "multilineText"},
        {"name": "Session QC", "type": "formula", "apiCreatable": false, "manual": "See docs/airtable-schema.md section 14"},
        {"name": "Point Count", "type": "count", "apiCreatable": false, "manual": "Count of linked Point Features"},
        {"name": "Line Count", "type": "count", "apiCreatable": false, "manual": "Count of linked Line Features"}
      ]
    },
    {
      "name": "Panels",
      "description": "Tilt-up panel register: casting, erection sequence, as-built QA.",
      "primaryField": "Panel Mark",
      "fields": [
        {"name": "Panel Mark", "type": "singleLineText"},
        {"name": "Project", "type": "multipleRecordLinks", "linkedTable": "Projects"},
        {"name": "Area", "type": "multipleRecordLinks", "linkedTable": "Areas"},
        {"name": "Panel Type", "type": "singleSelect", "options": {"choices": ["Solid", "Window", "Door", "Dock", "Corner", "Return", "Parapet", "Reveal", "Spandrel"]}},
        {"name": "Width (ft)", "type": "number", "options": {"precision": 3}},
        {"name": "Height (ft)", "type": "number", "options": {"precision": 3}},
        {"name": "Thickness (in)", "type": "number", "options": {"precision": 2}},
        {"name": "Opening SF", "type": "number", "options": {"precision": 1}},
        {"name": "Casting Bed", "type": "singleLineText"},
        {"name": "Stack Position", "type": "number", "options": {"precision": 0}},
        {"name": "Cast Sequence", "type": "number", "options": {"precision": 0}},
        {"name": "Cast Date", "type": "date"},
        {"name": "Strip Date", "type": "date"},
        {"name": "Erection Sequence", "type": "number", "options": {"precision": 0}},
        {"name": "Crane Pick #", "type": "number", "options": {"precision": 0}},
        {"name": "Erection Date", "type": "date"},
        {"name": "Set Status", "type": "singleSelect", "options": {"choices": ["Not Cast", "Cast", "Cured", "Stripped", "Staged", "Erected", "Braced", "Welded", "Grouted", "Braces Removed", "Patched", "Accepted"]}},
        {"name": "Rigging Type", "type": "singleSelect", "options": {"choices": ["2-point", "4-point", "6-point", "8-point", "Strongback", "Spreader Bar"]}},
        {"name": "Lift Insert Count", "type": "number", "options": {"precision": 0}},
        {"name": "Brace Count", "type": "number", "options": {"precision": 0}},
        {"name": "As-Built Base Elev L", "type": "number", "options": {"precision": 3}},
        {"name": "As-Built Base Elev R", "type": "number", "options": {"precision": 3}},
        {"name": "Plumb Deviation (in)", "type": "number", "options": {"precision": 3}},
        {"name": "Plumb Tolerance (in)", "type": "number", "options": {"precision": 3}},
        {"name": "Joint Width Left (in)", "type": "number", "options": {"precision": 3}},
        {"name": "Joint Width Right (in)", "type": "number", "options": {"precision": 3}},
        {"name": "Panel Top Elevation", "type": "number", "options": {"precision": 3}},
        {"name": "Alignment Δ (in)", "type": "number", "options": {"precision": 3}},
        {"name": "Shop Drawing", "type": "multipleAttachments"},
        {"name": "Photos", "type": "multipleAttachments"},
        {"name": "Notes", "type": "multilineText"},
        {"name": "Area SF", "type": "formula", "apiCreatable": false, "manual": "{Width (ft)}*{Height (ft)}"},
        {"name": "Net Weight (lbs)", "type": "formula", "apiCreatable": false, "manual": "({Area SF}-{Opening SF})*({Thickness (in)}/12)*150"},
        {"name": "Panel QC", "type": "formula", "apiCreatable": false, "manual": "See docs/airtable-schema.md section 14"}
      ]
    },
    {
      "name": "Point Features",
      "description": "Main point table. Feature ID is the Mapbox promoteId.",
      "primaryField": "Feature ID",
      "fields": [
        {"name": "Feature ID", "type": "singleLineText"},
        {"name": "Point Number", "type": "number", "options": {"precision": 0}},
        {"name": "Feature Code", "type": "multipleRecordLinks", "linkedTable": "Feature Codes"},
        {"name": "Layer", "type": "multipleRecordLinks", "linkedTable": "Layers"},
        {"name": "Project", "type": "multipleRecordLinks", "linkedTable": "Projects"},
        {"name": "Area", "type": "multipleRecordLinks", "linkedTable": "Areas"},
        {"name": "Panel", "type": "multipleRecordLinks", "linkedTable": "Panels"},
        {"name": "Survey Session", "type": "multipleRecordLinks", "linkedTable": "Survey Sessions"},
        {"name": "Northing", "type": "number", "options": {"precision": 3}},
        {"name": "Easting", "type": "number", "options": {"precision": 3}},
        {"name": "Elevation", "type": "number", "options": {"precision": 3}},
        {"name": "Longitude", "type": "number", "options": {"precision": 8}},
        {"name": "Latitude", "type": "number", "options": {"precision": 8}},
        {"name": "Geometry Source", "type": "singleSelect", "options": {"choices": ["Field Shot", "Design/Model", "Calculated", "Digitized"]}},
        {"name": "Design Northing", "type": "number", "options": {"precision": 3}},
        {"name": "Design Easting", "type": "number", "options": {"precision": 3}},
        {"name": "Design Elevation", "type": "number", "options": {"precision": 3}},
        {"name": "Status", "type": "singleSelect", "options": {"choices": ["Design", "Staked", "As-Built", "Verified", "Out of Tolerance", "Superseded", "Void"]}},
        {"name": "Solution Type", "type": "singleSelect", "options": {"choices": ["RTK Fixed", "RTK Float", "Autonomous", "Static", "Total Station", "Scan", "Derived"]}},
        {"name": "Accuracy H (ft)", "type": "number", "options": {"precision": 3}},
        {"name": "Accuracy V (ft)", "type": "number", "options": {"precision": 3}},
        {"name": "Revision", "type": "number", "options": {"precision": 0}},
        {"name": "QC Checked By", "type": "singleLineText"},
        {"name": "QC Checked Date", "type": "date"},
        {"name": "Description", "type": "multilineText"},
        {"name": "Photos", "type": "multipleAttachments"},
        {"name": "Include in Tileset", "type": "checkbox"},
        {"name": "Last Exported", "type": "date"},
        {"name": "Superseded By", "type": "multipleRecordLinks", "linkedTable": "Point Features"},
        {"name": "Export Batch", "type": "multipleRecordLinks", "linkedTable": "Export Batches"},
        {"name": "Embed", "type": "multipleRecordLinks", "linkedTable": "Embeds"},
        {"name": "Issues", "type": "multipleRecordLinks", "linkedTable": "Issues"},
        {"name": "Δ N", "type": "formula", "apiCreatable": false, "manual": "IF(AND({Design Northing} != BLANK(), {Northing} != BLANK()), {Northing}-{Design Northing}, BLANK())"},
        {"name": "Δ E", "type": "formula", "apiCreatable": false, "manual": "IF(AND({Design Easting} != BLANK(), {Easting} != BLANK()), {Easting}-{Design Easting}, BLANK())"},
        {"name": "Δ Z", "type": "formula", "apiCreatable": false, "manual": "IF(AND({Design Elevation} != BLANK(), {Elevation} != BLANK()), {Elevation}-{Design Elevation}, BLANK())"},
        {"name": "Δ H", "type": "formula", "apiCreatable": false, "manual": "IF(AND({Δ N} != BLANK(), {Δ E} != BLANK()), SQRT(POWER({Δ N},2)+POWER({Δ E},2)), BLANK())"},
        {"name": "Δ H (in)", "type": "formula", "apiCreatable": false, "manual": "IF({Δ H} != BLANK(), ROUND({Δ H}*12,3), BLANK())"},
        {"name": "Tolerance H", "type": "multipleLookupValues", "apiCreatable": false, "manual": "Lookup Tolerance H (ft) from Feature Code"},
        {"name": "Tolerance V", "type": "multipleLookupValues", "apiCreatable": false, "manual": "Lookup Tolerance V (ft) from Feature Code"},
        {"name": "QC Result", "type": "formula", "apiCreatable": false, "manual": "See docs/airtable-schema.md section 14"},
        {"name": "Airtable Record ID", "type": "formula", "apiCreatable": false, "manual": "RECORD_ID()"}
      ],
      "views": [
        {"name": "Map Export", "filter": "Include in Tileset is checked AND Status is not Void/Superseded"},
        {"name": "Out of Tolerance", "filter": "QC Result = Fail, grouped by Panel"},
        {"name": "Unverified As-Builts", "filter": "Status = As-Built AND QC Checked Date is empty"},
        {"name": "Today's Shots", "filter": "grouped by Survey Session, sorted desc"},
        {"name": "Missing Coordinates", "filter": "Longitude is empty"}
      ]
    },
    {
      "name": "Line Features",
      "description": "Main line table. WGS84 vertex array lives in Geometry GeoJSON.",
      "primaryField": "Feature ID",
      "fields": [
        {"name": "Feature ID", "type": "singleLineText"},
        {"name": "Feature Code", "type": "multipleRecordLinks", "linkedTable": "Feature Codes"},
        {"name": "Layer", "type": "multipleRecordLinks", "linkedTable": "Layers"},
        {"name": "Project", "type": "multipleRecordLinks", "linkedTable": "Projects"},
        {"name": "Area", "type": "multipleRecordLinks", "linkedTable": "Areas"},
        {"name": "Panel", "type": "multipleRecordLinks", "linkedTable": "Panels"},
        {"name": "Survey Session", "type": "multipleRecordLinks", "linkedTable": "Survey Sessions"},
        {"name": "Line Type", "type": "singleSelect", "options": {"choices": ["Gridline", "Panel Footprint", "Panel Joint", "Footing", "Slab Edge", "Saw Cut", "Curb/Flowline", "Utility Run", "Property Line", "Easement", "Setback", "Fence", "Crane Path", "Fire Lane", "Offset Line", "Breakline"]}},
        {"name": "Geometry GeoJSON", "type": "multilineText", "note": "[[lon,lat],...] WGS84. 100k char cap ~= 3500 vertices."},
        {"name": "Vertex Coordinates (Grid)", "type": "multilineText", "note": "[[N,E,Z],...] surveyor-facing copy"},
        {"name": "Vertex Count", "type": "number", "options": {"precision": 0}},
        {"name": "Length (ft)", "type": "number", "options": {"precision": 3}},
        {"name": "Start N", "type": "number", "options": {"precision": 3}},
        {"name": "Start E", "type": "number", "options": {"precision": 3}},
        {"name": "Start Z", "type": "number", "options": {"precision": 3}},
        {"name": "End N", "type": "number", "options": {"precision": 3}},
        {"name": "End E", "type": "number", "options": {"precision": 3}},
        {"name": "End Z", "type": "number", "options": {"precision": 3}},
        {"name": "Bearing", "type": "singleLineText"},
        {"name": "Grade %", "type": "number", "options": {"precision": 3}},
        {"name": "Grid Label", "type": "singleLineText"},
        {"name": "Start Point", "type": "multipleRecordLinks", "linkedTable": "Point Features"},
        {"name": "End Point", "type": "multipleRecordLinks", "linkedTable": "Point Features"},
        {"name": "Utility Type", "type": "singleSelect", "options": {"choices": ["Storm", "Sanitary", "Water", "Fire", "Gas", "Electrical", "Comm", "Irrigation", "Unknown"]}},
        {"name": "Pipe Size (in)", "type": "number", "options": {"precision": 2}},
        {"name": "Pipe Material", "type": "singleSelect", "options": {"choices": ["RCP", "PVC", "HDPE", "DIP", "CMP", "Copper", "Conduit", "Other"]}},
        {"name": "Invert Start", "type": "number", "options": {"precision": 3}},
        {"name": "Invert End", "type": "number", "options": {"precision": 3}},
        {"name": "Cover at Start (ft)", "type": "number", "options": {"precision": 2}},
        {"name": "Cover at End (ft)", "type": "number", "options": {"precision": 2}},
        {"name": "Utility Status", "type": "singleSelect", "options": {"choices": ["Existing", "New", "Abandoned", "Potholed", "Located (SUE)", "Unknown"]}},
        {"name": "SUE Quality Level", "type": "singleSelect", "options": {"choices": ["A", "B", "C", "D"]}},
        {"name": "Status", "type": "singleSelect", "options": {"choices": ["Design", "Staked", "As-Built", "Verified", "Out of Tolerance", "Superseded", "Void"]}},
        {"name": "Design Line", "type": "multipleRecordLinks", "linkedTable": "Line Features"},
        {"name": "Description", "type": "multilineText"},
        {"name": "Photos", "type": "multipleAttachments"},
        {"name": "Include in Tileset", "type": "checkbox"},
        {"name": "Last Exported", "type": "date"},
        {"name": "Export Batch", "type": "multipleRecordLinks", "linkedTable": "Export Batches"},
        {"name": "Issues", "type": "multipleRecordLinks", "linkedTable": "Issues"},
        {"name": "Airtable Record ID", "type": "formula", "apiCreatable": false, "manual": "RECORD_ID()"}
      ]
    },
    {
      "name": "Embeds",
      "description": "Embed/insert fabrication and QA detail. Location lives on the linked Point Feature.",
